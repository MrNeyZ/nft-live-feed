# nft-live-feed backend env.
# Copy to `.env` and edit; never commit your `.env`.
# Production refuses to boot if any required value is missing or weak —
# see `src/runtime/env-validation.ts` for the exact rules.

# ── Core runtime ──────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001

# ── Auth / access ─────────────────────────────────────────────────────────
# When `true`, login goes through /api/auth/siws/{nonce,verify}: the user
# connects a Solana wallet and signs a server-issued nonce. The legacy
# /api/auth/login is then 410. When unset/`false`, the legacy passphrase
# path is active.
AUTH_REQUIRE_SIWS=true

# Shared invite passphrase. When AUTH_REQUIRE_SIWS=true this can be a
# short human-shareable code ("beta") — the wallet signature is the real
# factor. When false, this is the only login secret and must be ≥16 chars.
UI_AUTH_PASSWORD=beta-access-2026

# HMAC-SHA256 signing secret for the 12 h bearer token issued after
# login. Must be a long random value (≥16 chars enforced at boot,
# unconditional of SIWS state). Rotate to invalidate every live session.
UI_AUTH_SECRET=replace_with_long_random_secret

# Comma-separated base58 wallet pubkeys allowed to log in. Enforced at
# both /api/auth/siws/nonce and /api/auth/siws/verify. Empty/unset means
# "no whitelist" (dev only — production must set this).
UI_ALLOWED_WALLETS=wallet1,wallet2

# Comma-separated browser origins that may call /api/*. Replaces the
# old `Access-Control-Allow-Origin: *`. Required in production.
UI_ALLOWED_ORIGINS=https://victorylabs.app

# Domain header embedded in the SIWS canonical message. Must match the
# host the user sees in their browser bar. Defaults to victorylabs.app
# when unset.
SIWS_DOMAIN=victorylabs.app
# Optional URI override for the SIWS message (defaults to https://<SIWS_DOMAIN>).
# SIWS_URI=https://victorylabs.app

# ── Solana / Helius ───────────────────────────────────────────────────────
# Backend reads HELIUS_API_KEY directly and composes the RPC URL
# internally. The two URL overrides below are reserved for a future
# proxy-mode and are NOT consumed by the current code.
HELIUS_API_KEY=
HELIUS_RPC_URL=
SOLANA_RPC_URL=

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@localhost:5432/nftfeed

# ── Optional webhooks ─────────────────────────────────────────────────────
# Bearer secret for POST /webhooks/helius. When unset, the route is
# unmounted entirely (404) — the Helius webhook path stays disabled.
# When set, requests must carry `Authorization: <value>` exactly.
HELIUS_WEBHOOK_AUTH=

# ── Optional ME / Tensor keys ─────────────────────────────────────────────
# Only needed by routes that hit those marketplaces directly. Unset = use
# anonymous tier (rate-limited).
# ME_API_KEY=
# TENSOR_API_KEY=

# ── Optional tuning ───────────────────────────────────────────────────────
# Placeholder for the deeper seller-count survey path. Currently not
# consumed by the backend; reserved for future use.
SELLER_COUNT_DEEP_SCAN=false

# ── Optional logging / debug ──────────────────────────────────────────────
# Reserved. The backend currently uses `console.*` with per-subsystem
# debug flags (SELLER_COUNT_DEBUG=1, MINTS_DEBUG=1, …); LOG_LEVEL itself
# is not yet consumed.
LOG_LEVEL=info

# Optional: append startup banner + early errors to this file too.
# LOG_FILE=/var/log/nft-live-feed/backend.out.log

# ── Rare Feed tool (src/rare-feed/) ───────────────────────────────────────
# Rare Feed consumes the existing live sale events (no new ingestion, no extra
# Helius calls), enriches them with rarity (provider chain below), scores/
# filters them, and serves value sales at GET /api/tools/rare-feed/recent
# (UI: /tools/rare-feed).
# Master kill switch — set to false to disable the evaluator + retention.
RARE_FEED_ENABLED=true
# Per-mint rarity cache TTL for POSITIVE (rank found) results. Default 24h.
RARE_FEED_RARITY_TTL_MS=86400000
# Shorter TTL for NEGATIVE (no-rank) results so a newly-ranked collection is
# re-checked without spamming the providers. Default 30m.
RARE_FEED_NEGATIVE_TTL_MS=1800000
# Max concurrent rarity HTTP fetches across all providers (clamped 2–4). Default 3.
RARE_FEED_RARITY_CONCURRENCY=3
# How long accepted rare events are kept. Default 7 days.
RARE_FEED_RETENTION_DAYS=7
# How long per-mint rarity cache rows (mint_rarity_cache) are kept before a
# periodic prune deletes them. Far longer than the freshness TTLs above, so
# pruning only removes long-stale rows (re-fetched on demand anyway). Default 14d.
RARE_FEED_RARITY_CACHE_RETENTION_DAYS=14
# Default minimum rare-score returned by the recent endpoint (0–100). Kept at 40
# (not higher) so the default view isn't misleadingly empty — many genuine
# below-floor qualifiers score under 55. Frontend default selector matches.
# The frontend can override per-request via ?minScore=.
RARE_FEED_MIN_SCORE=40
#
# ── Rarity provider chain ──
# Priority: Tensor (if TENSOR_API_KEY set) → HowRare → Magic Eden.
#   • TENSOR_API_KEY (see ME/Tensor section above): when set, the official
#     tensordev.io API becomes the PRIMARY rank source; unset → Tensor skipped.
#   • HowRare.is is the working keyless source today (per-mint rank + supply).
#   • Magic Eden contributes a rank only when its token payload carries one
#     (rare for Solana collections), so it is the last-resort fallback.
RARE_FEED_HOWRARE_ENABLED=true
# HowRare slugs sometimes differ from Magic Eden slugs. Built-in aliases cover
# the obvious ones (solana_monkey_business→smb); extend as
# "meSlug:howrareSlug,meSlug2:howrareSlug2".
# RARE_FEED_HOWRARE_ALIASES=
