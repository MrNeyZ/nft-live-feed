{
  "name": "nft-live-feed",
  "version": "0.1.0",
  "description": "Solana-wide live NFT sales feed backend",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "nodemon --exec ts-node src/index.ts",
    "start": "node dist/index.js",
    "migrate": "ts-node src/db/migrate.ts",
    "pixel-forge:validate": "ts-node src/scripts/pixel-forge-validation.ts",
    "test:mint-analyzer": "ts-node src/mint-analyzer/__tests__/analyze.test.ts",
    "test:holders-tool": "ts-node src/tools-holders/__tests__/analyze.test.ts",
    "test:prnt-detector": "ts-node src/ingestion/mint-raw/__tests__/prnt-detector.test.ts",
    "test:mint-accumulator": "MINT_BURST_V60=2 MINT_BURST_V5M=2 MINT_DISPLAY_THRESHOLD=50 MINT_IDLE_COOLDOWN_MS=1 ts-node src/mints/__tests__/accumulator-revival.test.ts",
    "test:mint-price-relayer": "ts-node src/ingestion/mint-raw/mint-price-relayer.test.ts",
    "test:tensor-cnft-price": "ts-node src/ingestion/tensor-raw/__tests__/cnft-price.test.ts",
    "test:tamm-sell-buyer": "ts-node src/ingestion/tensor-raw/__tests__/tamm-sell-buyer.test.ts",
    "test:me-cache-consolidation": "ts-node src/enrichment/me-cache-consolidation.test.ts",
    "backfill:me": "ts-node src/scripts/backfill-collection-sales.ts",
    "backfill:me-logprice": "ts-node src/scripts/backfill-me-v2-logprice.ts",
    "debug:mints:launchpads": "ts-node src/scripts/debug-mints-launchpads.ts",
    "debug:mints:supply": "ts-node src/scripts/debug-mints-supply.ts",
    "debug:mints:launchpad-survey": "ts-node src/scripts/debug-mints-launchpad-survey.ts",
    "debug:lmnft-config": "ts-node src/scripts/debug-lmnft-config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "sharp": "^0.35.3",
    "tweetnacl": "^1.0.3",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "@types/ws": "^8.18.1",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.2"
  }
}
